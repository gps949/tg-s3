# ===== Required (only 3 items) / 必填项 (仅需 3 项) =====

# Telegram Bot Token (from @BotFather)
# Telegram Bot Token (从 @BotFather 获取)
TG_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Telegram group ID (the bot must be an administrator, e.g. -1001234567890)
# Telegram 群组 ID (Bot 必须是管理员, 如 -1001234567890)
DEFAULT_CHAT_ID=-1001234567890

# Cloudflare API Token
# Create at: https://dash.cloudflare.com/profile/api-tokens
# Minimum permissions: Workers Scripts:Edit, D1:Edit, R2:Edit, Account Settings:Read
# For tunnel auto-creation, also add: Cloudflare Tunnel:Edit, DNS:Edit
# (optional for local development, use wrangler login instead)
# 创建: https://dash.cloudflare.com/profile/api-tokens
# 最低权限: Workers Scripts:Edit, D1:Edit, R2:Edit, Account Settings:Read
# 如需自动创建 tunnel: 额外需要 Cloudflare Tunnel:Edit, DNS:Edit
# (本地开发可不填, 用 wrangler login 代替)
CLOUDFLARE_API_TOKEN=

# ===== Optional (strongly recommended) / 可选项 (强烈推荐) =====

# Telegram user IDs allowed to use the bot (comma-separated, e.g. 123456789,987654321)
# If unset, ANY Telegram user can use the bot (not recommended)
# Get your user ID by messaging @userinfobot
# 允许使用 Bot 的 Telegram 用户 ID (逗号分隔, 如 123456789,987654321)
# 不设置则任何 Telegram 用户都可使用 Bot (不推荐)
# 获取方式: 向 @userinfobot 发送消息获取你的用户 ID
TG_ADMIN_IDS=

# ===== Optional / 可选项 =====

# Cloudflare Account ID (needed for multi-account setups; auto-detected for single accounts)
# The legacy name CF_ACCOUNT_ID still works but is deprecated
# Cloudflare Account ID (多账户时需要; 单账户自动检测)
# 旧名 CF_ACCOUNT_ID 仍可用但已弃用
CLOUDFLARE_ACCOUNT_ID=

# Custom domain for the Worker (leave empty to use the workers.dev subdomain)
# When set, deploy.sh auto-creates a Cloudflare Tunnel and configures DNS
# Worker 自定义域名 (留空则使用 workers.dev 子域)
# 填写后 deploy.sh 会自动创建 Cloudflare Tunnel 并配置 DNS
CF_CUSTOM_DOMAIN=

# Telegram API credentials (from https://my.telegram.org)
# Enables the Local Bot API -- one of the two requirements for 2GB file support
# (2GB also needs a Worker-reachable processor: set CF_CUSTOM_DOMAIN for tunnel
#  auto-creation, or set CF_TUNNEL_TOKEN + VPS_URL manually)
# If unset, the public Bot API is used and the file size limit is 20MB
# Telegram API 凭据 (从 https://my.telegram.org 获取)
# 用于启用 Local Bot API, 是 2GB 大文件支持的条件之一
# (2GB 还需 Worker 可访问的 processor: 设置 CF_CUSTOM_DOMAIN 自动创建 Tunnel,
#  或手动设置 CF_TUNNEL_TOKEN + VPS_URL)
# 不填则使用公共 Bot API, 文件限制 20MB
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Deploy script output language: en or zh
# Defaults to the system locale (zh* -> Chinese, otherwise English)
# 部署脚本输出语言: en 或 zh (默认跟随系统语言)
TGS3_LANG=

# ===== Auto-generated (no need to set manually) / 自动生成项 (无需手动设置) =====
# The variables below are generated by deploy.sh and written to this file automatically
# 以下变量由 deploy.sh 自动生成并写入本文件, 无需手动填写

# VPS_SECRET=             # Worker <-> Processor shared secret / 共享密钥
# D1_DATABASE_ID=         # D1 database ID (recorded after first deploy) / D1 数据库 ID (首次部署后自动记录)
# CF_TUNNEL_TOKEN=        # Cloudflare Tunnel token (auto-created) / (自动创建)
# VPS_URL=                # Processor URL (auto-set to the tunnel hostname) / Processor 访问地址 (自动设为 tunnel 域名)
